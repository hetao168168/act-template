formulas:
  updated: file.mtime.format("MM-DD")
  backlink_count: file.backlinks.length
properties:
  created:
    displayName: 创建
  author:
    displayName: 作者
  source:
    displayName: 来源
  index:
    displayName: 索引
  formula.updated:
    displayName: 修改
  formula.backlink_count:
    displayName: 引用数
views:
  - type: table
    name: 核心卡总览
    filters:
      and:
        - file.inFolder("20-Card/23-MainCard-核心卡")
        - file.ext == "md"
    order:
      - file.name
      - created
      - index
      - formula.updated
    sort:
      - property: index
        direction: DESC
  - type: table
    name: 阅读卡总览
    filters:
      and:
        - file.inFolder("20-Card/22-BibCard-阅读卡")
        - file.ext == "md"
    order:
      - file.name
      - created
      - author
      - source
      - formula.updated
  - type: table
    name: 索引卡总览
    filters:
      and:
        - file.inFolder("20-Card/21-IndexCard-索引卡")
        - file.ext == "md"
    order:
      - file.name
      - formula.backlink_count
      - formula.updated
    sort: []
    summaries:
      formula.backlink_count: Sum
